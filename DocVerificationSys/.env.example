# ============================================================
# Document Verification & Approval System — Environment Config
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_NAME=DocVerify

# --- Session ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING
ADMIN_EMAIL=admin@docverify.local

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=docverify
DB_USER=docverify_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- File Storage ---
# Private path outside src/public. Keep this out of the web root.
STORAGE_PATH=./storage/uploads
MAX_FILE_SIZE_MB=10
MAX_PAGES=50

# --- OCR Service ---
OCR_SERVICE_URL=http://localhost:8000
OCR_SERVICE_API_KEY=CHANGE_ME_GENERATE_A_RANDOM_SHARED_KEY
OCR_TIMEOUT_MS=60000
TESSERACT_CMD="C:\Program Files\Tesseract-OCR\tesseract.exe"

# --- AI providers ---
# Gemini is primary by default; Ollama is used for quota/credential failures.
AI_PROVIDER=gemini
OLLAMA_FALLBACK_ENABLED=true
OLLAMA_MODEL=qwen2.5:3b
# Optional when AI_PROVIDER=ollama or Ollama fallback is enabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
AI_TIMEOUT_MS=30000

# --- Security ---
BCRYPT_ROUNDS=12
SESSION_MAX_AGE_MS=28800000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_LOGIN=10

# --- Email (optional — password reset) ---
# Leave blank to disable email features
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Production HTTPS ---
COOKIE_SECURE=false
TRUST_PROXY=false
