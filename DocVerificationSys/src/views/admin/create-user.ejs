<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> | <%= appName %></title><link rel="stylesheet" href="/css/main.css"></head>
<body><div class="app-layout"><%- include('../partials/sidebar', { user, unreadCount }) %><main class="main-content"><%- include('../partials/topbar', { title, breadcrumbs: [{ label: 'Users', url: '/admin/users' }, { label: 'Create user' }] }) %><div class="page-content">
<h1 class="page-title">Create user</h1><% if (errors.length) { %><div class="errors-list"><ul><% errors.forEach(error => { %><li><%= error.msg %></li><% }) %></ul></div><% } %>
<div class="card" style="max-width:680px"><div class="card-body"><form method="POST" action="/admin/users"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="form-group"><label class="form-label form-required" for="full_name">Full name</label><input class="form-control" id="full_name" name="full_name" value="<%= values.full_name || '' %>" required maxlength="200"></div>
<div class="form-group"><label class="form-label form-required" for="email">Email</label><input class="form-control" type="email" id="email" name="email" value="<%= values.email || '' %>" required></div>
<div class="form-group"><label class="form-label form-required" for="role">Role</label><select class="form-control" id="role" name="role" required><% ['submitter','reviewer','approver','admin'].forEach(roleName => { %><option value="<%= roleName %>"><%= roleName %></option><% }) %></select></div>
<div class="form-group"><label class="form-label form-required" for="password">Temporary password</label><input class="form-control" type="password" id="password" name="password" minlength="10" required><span class="form-hint">At least 10 characters; include upper/lowercase letters and a number.</span></div>
<button class="btn btn-primary" type="submit">Create account</button></form></div></div>
</div></main></div></body></html>
