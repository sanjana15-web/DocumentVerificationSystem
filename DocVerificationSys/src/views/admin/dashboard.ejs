<%- include('../partials/helpers') %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> | <%= appName %></title><link rel="stylesheet" href="/css/main.css"></head>
<body><div class="app-layout"><%- include('../partials/sidebar', { user, unreadCount, activePage: 'admin-dash' }) %><main class="main-content"><%- include('../partials/topbar', { title, breadcrumbs: [{ label: 'Administration' }] }) %><div class="page-content">
<h1 class="page-title">Administrator dashboard</h1><p class="page-subtitle">Live counts from this installation.</p>
<div class="stat-grid"><% Object.entries(submissionCounts).forEach(([status, count]) => { %><div class="stat-card"><div class="stat-label"><%= status.replace(/_/g, ' ') %></div><div class="stat-value"><%= count %></div></div><% }) %></div>
<div class="card mb-16"><div class="card-header"><span class="card-title">Users by role</span><a class="btn btn-outline btn-sm" href="/admin/users">Manage users</a></div><div class="table-wrapper"><table><thead><tr><th>Role</th><th>Total</th><th>Active</th></tr></thead><tbody><% userCounts.forEach(item => { %><tr><td><%= item.role %></td><td><%= item.count %></td><td><%= item.active %></td></tr><% }) %></tbody></table></div></div>
<div class="card mb-16"><div class="card-header"><span class="card-title">Processing jobs</span></div><div class="table-wrapper"><table><thead><tr><th>Status</th><th>Count</th></tr></thead><tbody><% jobStats.forEach(item => { %><tr><td><%= item.status %></td><td><%= item.cnt %></td></tr><% }) %></tbody></table></div></div>
<div class="card"><div class="card-header"><span class="card-title">Recent audit events</span><a class="btn btn-outline btn-sm" href="/admin/audit">View all</a></div><div class="table-wrapper"><table><thead><tr><th>When</th><th>Actor</th><th>Action</th><th>Target</th></tr></thead><tbody><% recentAudit.forEach(event => { %><tr><td><%= fmtDateTime(event.created_at) %></td><td><%= event.actor_email || 'System' %></td><td><%= event.action %></td><td><%= event.entity_type %> <%= event.entity_id || '' %></td></tr><% }) %></tbody></table></div></div>
</div></main></div></body></html>
