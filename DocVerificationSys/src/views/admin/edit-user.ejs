<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> | <%= appName %></title><link rel="stylesheet" href="/css/main.css"></head>
<body><div class="app-layout"><%- include('../partials/sidebar', { user, unreadCount }) %><main class="main-content"><%- include('../partials/topbar', { title, breadcrumbs: [{ label: 'Users', url: '/admin/users' }, { label: 'Edit user' }] }) %><div class="page-content">
<h1 class="page-title">Edit user</h1><div class="card" style="max-width:680px"><div class="card-body"><form method="POST" action="/admin/users/<%= target.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="form-group"><label class="form-label" for="full_name">Full name</label><input class="form-control" id="full_name" name="full_name" value="<%= target.full_name %>" required maxlength="200"></div>
<div class="form-group"><label class="form-label" for="role">Role</label><select class="form-control" id="role" name="role"><% ['submitter','reviewer','approver','admin'].forEach(roleName => { %><option value="<%= roleName %>" <%= target.role === roleName ? 'selected' : '' %>><%= roleName %></option><% }) %></select></div>
<div class="form-group"><label class="form-label" for="is_active">Account status</label><select class="form-control" id="is_active" name="is_active"><option value="1" <%= target.is_active ? 'selected' : '' %>>Active</option><option value="0" <%= !target.is_active ? 'selected' : '' %>>Deactivated</option></select></div>
<button class="btn btn-primary" type="submit">Save changes</button></form></div></div>
</div></main></div></body></html>
