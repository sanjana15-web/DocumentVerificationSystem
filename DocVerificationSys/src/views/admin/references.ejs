<%- include('../partials/helpers') %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> | <%= appName %></title><link rel="stylesheet" href="/css/main.css"></head>
<body><div class="app-layout"><%- include('../partials/sidebar', { user, unreadCount, activePage: 'references' }) %><main class="main-content"><%- include('../partials/topbar', { title, breadcrumbs: [{ label: 'Administration', url: '/admin' }, { label: 'Reference Records' }] }) %><div class="page-content">
<%- include('../partials/flash', { flash }) %><h1 class="page-title">Trusted purchase-order records</h1><p class="page-subtitle">Only records verified from an authorized source are used for invoice comparisons. No sample records are preloaded.</p>
<div class="card mb-16"><div class="card-header"><span class="card-title">Add a verified purchase order</span></div><div class="card-body"><form method="POST" action="/admin/references"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="form-row"><div class="form-group"><label class="form-label form-required" for="reference_key">Purchase order number</label><input class="form-control" id="reference_key" name="reference_key" required maxlength="255"></div><div class="form-group"><label class="form-label form-required" for="supplier_name">Supplier name</label><input class="form-control" id="supplier_name" name="supplier_name" required maxlength="255"></div><div class="form-group"><label class="form-label form-required" for="total_amount">Total amount</label><input class="form-control" id="total_amount" name="total_amount" type="number" min="0" step="0.01" required></div><div class="form-group"><label class="form-label" for="currency">Currency</label><input class="form-control" id="currency" name="currency" maxlength="3"></div></div>
<div class="form-row"><div class="form-group"><label class="form-label form-required" for="source_name">Authorized source</label><input class="form-control" id="source_name" name="source_name" required maxlength="255"></div><div class="form-group"><label class="form-label" for="source_reference">Source record / URL</label><input class="form-control" id="source_reference" name="source_reference" maxlength="255"></div></div>
<button class="btn btn-primary" type="submit">Save trusted record</button></form></div></div>
<div class="card"><div class="table-wrapper"><table><thead><tr><th>PO number</th><th>Supplier / total</th><th>Source</th><th>Verified by</th><th>Status</th><th></th></tr></thead><tbody>
<% references.forEach(record => { const data = typeof record.record_data === 'string' ? JSON.parse(record.record_data) : record.record_data; %><tr><td><%= record.reference_key %></td><td><%= data.supplier_name || '—' %><br><span class="text-sm text-muted"><%= data.currency || '' %> <%= data.total_amount || '—' %></span></td><td><%= record.source_name %><% if (record.source_reference) { %><div class="text-sm text-muted"><%= record.source_reference %></div><% } %></td><td><%= record.verifier_name %><br><span class="text-sm text-muted"><%= fmtDateTime(record.verified_at) %></span></td><td><%= record.is_active ? 'Active' : 'Inactive' %></td><td><% if (record.is_active) { %><form method="POST" action="/admin/references/<%= record.id %>/deactivate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline btn-sm" type="submit">Deactivate</button></form><% } %></td></tr><% }) %>
</tbody></table></div></div>
</div></main></div></body></html>
