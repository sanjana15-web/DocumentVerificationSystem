<%- include('../partials/helpers') %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> | <%= appName %></title><link rel="stylesheet" href="/css/main.css"></head>
<body><div class="app-layout"><%- include('../partials/sidebar', { user, unreadCount, activePage: 'admin-users' }) %><main class="main-content"><%- include('../partials/topbar', { title, breadcrumbs: [{ label: 'Administration', url: '/admin' }, { label: 'Users' }] }) %><div class="page-content">
<%- include('../partials/flash', { flash }) %><div class="page-header"><div><h1 class="page-title">User management</h1><p class="page-subtitle"><%= total %> accounts</p></div><a class="btn btn-primary" href="/admin/users/new">Create user</a></div>
<form method="GET" class="card mb-16"><div class="card-body"><label class="form-label" for="role">Filter by role</label><select class="form-control" name="role" id="role"><option value="">All roles</option><% ['submitter','reviewer','approver','admin'].forEach(roleName => { %><option value="<%= roleName %>" <%= filters.role === roleName ? 'selected' : '' %>><%= roleName %></option><% }) %></select><button class="btn btn-outline mt-8" type="submit">Filter</button></div></form>
<div class="card"><div class="table-wrapper"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Active</th><th>Last login</th><th></th></tr></thead><tbody><% users.forEach(account => { %><tr><td><%= account.full_name %></td><td><%= account.email %></td><td><%= account.role %></td><td><%= account.is_active ? 'Yes' : 'No' %></td><td><%= fmtDateTime(account.last_login_at) %></td><td><a class="btn btn-outline btn-sm" href="/admin/users/<%= account.id %>/edit">Edit</a></td></tr><% }) %></tbody></table></div></div>
</div></main></div></body></html>
