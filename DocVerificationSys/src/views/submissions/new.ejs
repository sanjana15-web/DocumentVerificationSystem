<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= appName %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar', { user, unreadCount, activePage: 'new-submission' }) %>
  <div class="main-content">
    <%- include('../partials/topbar', { title, breadcrumbs: [{ label: 'Submissions', url: '/submissions' }, { label: 'New Submission' }] }) %>
    <div class="page-content">

      <div class="page-header">
        <div>
          <h1 class="page-title">New Submission</h1>
          <p class="page-subtitle">Fill in the details and then upload your document.</p>
        </div>
      </div>

      <% if (errors && errors.length > 0) { %>
      <div class="errors-list"><ul><% errors.forEach(e => { %><li><%= e.msg %></li><% }) %></ul></div>
      <% } %>

      <div class="card" style="max-width:680px">
        <div class="card-header"><span class="card-title">Submission Details</span></div>
        <div class="card-body">
          <form method="POST" action="/submissions" id="new-submission-form" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="form-group">
              <label class="form-label form-required" for="title">Title / Description</label>
              <input type="text" id="title" name="title" class="form-control <%= errors.find(e=>e.param==='title') ? 'error' : '' %>"
                value="<%= values.title || '' %>" placeholder="e.g. Office supplies invoice — October 2024" required maxlength="500">
              <span class="form-hint">A brief description to identify this submission.</span>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="doc_category">Document Category</label>
                <select id="doc_category" name="doc_category" class="form-control">
                  <% documentTypes.forEach(type => { %>
                  <option value="<%= type.id %>" <%= (values.doc_category || 'invoice') === type.id ? 'selected' : '' %>><%= type.display_name || type.name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label" for="priority">Priority</label>
                <select id="priority" name="priority" class="form-control">
                  <option value="low"    <%= values.priority==='low'    ? 'selected':'' %>>Low</option>
                  <option value="normal" <%= (values.priority||'normal')==='normal' ? 'selected':'' %>>Normal</option>
                  <option value="high"   <%= values.priority==='high'   ? 'selected':'' %>>High</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="vendor_name">Vendor / Supplier Name</label>
              <input type="text" id="vendor_name" name="vendor_name" class="form-control"
                value="<%= values.vendor_name || '' %>" placeholder="Company or individual name" maxlength="500">
            </div>

            <div class="form-group">
              <label class="form-label" for="notes">Notes</label>
              <textarea id="notes" name="notes" class="form-control" rows="3"
                placeholder="Optional context or instructions for the reviewer"><%= values.notes || '' %></textarea>
            </div>

            <div style="display:flex;gap:12px;justify-content:flex-end;padding-top:8px">
              <a href="/submissions" class="btn btn-outline">Cancel</a>
              <button type="submit" class="btn btn-primary" id="create-btn">Create &amp; Upload Document →</button>
            </div>
          </form>
        </div>
      </div>

    </div>
  </div>
</div>
<script src="/js/main.js"></script>
</body>
</html>
